{
  "name": "open-myrsi-org",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENCE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "gen:types": "supabase gen types typescript --linked --schema public > lib/database.types.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev --audit-level=high",
    "start": "node dist-server/server.js"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "compression": "^1.8.2",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "html-react-parser": "^6.1.9",
    "konva": "^10.9.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "undici": "8.12.3",
    "web-push": "3.6.7"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2",
    "ip-address": "^10.7.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "protobufjs": false,
    "@google/genai": false
  }
}
